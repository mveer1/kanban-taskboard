rules_version = '2';

/**
 * Task Board — Firestore security rules.
 *
 * These are the real authorization boundary. The UI hides controls a user cannot
 * use, but that is a courtesy: anyone can call the Firestore REST API directly
 * with their own token, so every restriction that matters is written here.
 *
 * Model:
 *   workspaces/{wid}                    members map is the source of truth
 *   workspaces/{wid}/state/board        the board document
 *   workspaces/{wid}/backups/{id}       snapshots
 *   workspaces/{wid}/members/{uid}      display names for the member list
 *   workspaces/{wid}/invites/{email}    pending invitations
 *   users/{uid}                         profile and last-used workspace
 *   users/{uid}/prefs/{doc}             this user's preferences
 *
 * What these rules do NOT do: validate the board's contents. The board is stored
 * as a JSON string so it round-trips exactly, which means rules cannot inspect
 * it. Board validity is enforced client-side by shared/boardIntegrity.js — the
 * same code the Node server runs. The consequence is explicit and acceptable: a
 * member you invited could write a malformed board into a workspace they already
 * have write access to. Someone who is not a member cannot read or write
 * anything. Membership is the boundary; shape is a data-quality concern.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- helpers ---------------- */

    function signedIn() {
      return request.auth != null;
    }

    function wsPath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid);
    }

    function isMember(wid) {
      return signedIn()
        && exists(wsPath(wid))
        && request.auth.uid in get(wsPath(wid)).data.members;
    }

    function roleIn(wid) {
      return isMember(wid) ? get(wsPath(wid)).data.members[request.auth.uid] : '';
    }

    function isEditor(wid) {
      return signedIn() && (roleIn(wid) == 'owner' || roleIn(wid) == 'editor');
    }

    function isOwner(wid) {
      return signedIn() && roleIn(wid) == 'owner';
    }

    /** The email on the caller's token, lower-cased. Empty string for anonymous users. */
    function callerEmail() {
      return signedIn() && 'email' in request.auth.token && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    /* ---------------- collection group queries ---------------- */

    match /{path=**}/invites/{inviteId} {
      allow read: if signedIn() && callerEmail() != '' && resource.data.email == callerEmail();
    }

    /* ---------------- users ---------------- */

    match /users/{uid} {
      // Nobody needs to read anyone else's user document; member display names
      // come from the per-workspace members subcollection instead.
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /prefs/{document} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    /* ---------------- workspaces ---------------- */

    match /workspaces/{wid} {
      allow get: if signedIn() && (
        (resource.data.members != null && request.auth.uid in resource.data.members) ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );
      allow list: if signedIn() && resource.data.memberUids != null && request.auth.uid in resource.data.memberUids;

      /**
       * Creation must make the creator the owner and the only member.
       */
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.memberUids != null
        && request.resource.data.memberUids.hasOnly([request.auth.uid])
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;

      allow update: if isOwner(wid)
        || claimingOwnInvite(wid)
        || leavingSelf(wid);

      allow delete: if isOwner(wid);

      /** Accepting an invite: adds exactly this user, at exactly the invited role. */
      function claimingOwnInvite(wid) {
        let uid = request.auth.uid;
        let invitePath = /databases/$(database)/documents/workspaces/$(wid)/invites/$(callerEmail());
        return signedIn()
          && callerEmail() != ''
          && exists(invitePath)
          && !(uid in resource.data.members)
          && uid in request.resource.data.members
          && request.resource.data.members[uid] == get(invitePath).data.role
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.name == resource.data.name;
      }

      /** Leaving: drops only this user, and never the owner. */
      function leavingSelf(wid) {
        let uid = request.auth.uid;
        return isMember(wid)
          && resource.data.ownerUid != uid
          && !(uid in request.resource.data.members)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.name == resource.data.name;
      }

      /* ---------------- board ---------------- */

      match /state/{document} {
        allow read: if isMember(wid);
        // Size cap mirrors MAX_BOARD_BYTES in src/data/firebase.ts. Rules cannot
        // check the board's shape (it is an opaque string), but they can stop a
        // single document from being pushed to Firestore's 1 MiB ceiling.
        allow write: if isEditor(wid)
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && request.resource.data.rev is int
          // Revisions only ever move forward. Combined with the client-side
          // transaction this makes a stale overwrite impossible even from a
          // hand-rolled request.
          && (resource == null || request.resource.data.rev > resource.data.rev);
      }

      /* ---------------- snapshots ---------------- */

      match /backups/{backupId} {
        allow read: if isMember(wid);
        // Create and delete only: an existing snapshot must not be rewritten, or
        // "restore a known-good version" stops being a guarantee.
        allow create, delete: if isEditor(wid);
        allow update: if false;
      }

      /* ---------------- member display info ---------------- */

      match /members/{uid} {
        allow read: if isMember(wid);
        // A member may write their own display record; an owner may remove any.
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isOwner(wid) || (signedIn() && request.auth.uid == uid);
      }

      /* ---------------- invitations ---------------- */

      match /invites/{inviteId} {
        // Two readers: the workspace owner managing invitations, and the invitee
        // discovering theirs. The second is what makes the collection-group
        // query in listMyInvites safe — it can only ever return your own.
        allow get, list: if isOwner(wid)
          || (signedIn() && callerEmail() != '' && resource.data.email == callerEmail());

        allow create, update: if isOwner(wid)
          && request.resource.data.email is string
          && request.resource.data.role in ['editor', 'viewer'];

        // The owner revokes; the invitee accepts (which consumes it) or declines.
        allow delete: if isOwner(wid)
          || (signedIn() && callerEmail() != '' && resource.data.email == callerEmail());
      }
    }

    /**
     * Collection-group reads of `invites` resolve against the rule above, which
     * already restricts them to the caller's own email. No separate match block
     * is needed — and adding a permissive one would defeat it.
     */
  }
}
