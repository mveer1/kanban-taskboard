# ---------------------------------------------------------------------------
# Task Board environment
#
# Copy to `.env.local` (git-ignored) and fill in. Everything prefixed with
# VITE_ is inlined into the client bundle at build time — that is expected for
# Firebase web config, which is public by design. Access is controlled by
# Firestore security rules (see firestore.rules), never by hiding these values.
# ---------------------------------------------------------------------------

# Which persistence backend the client talks to.
#   local    -> the Node/Express API in server/ writing data/board.json
#   firebase -> Firestore + Firebase Auth (required for GitHub Pages)
VITE_DATA_BACKEND=local

# Base path for the built app. GitHub Pages serves from /<repo>/, so the Pages
# build sets this to /kanban-taskboard/. Leave as / for local and for hosts
# that serve from the domain root.
VITE_BASE=/

# ---------------------------------------------------------------------------
# Firebase web app config
# Console -> Project settings -> General -> Your apps -> SDK setup: Config
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_APP_ID

# Optional — only needed if you enable Google Analytics for the web app.
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Local development against the Firebase emulator suite (optional)
# Run `firebase emulators:start`, then set this to 1.
# ---------------------------------------------------------------------------
VITE_FIREBASE_USE_EMULATORS=0
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
