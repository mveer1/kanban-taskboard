{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Board data file",
  "description": "Contract for data/board.json. Validated by server/validate.js on every write and by `npm run validate`.",
  "type": "object",
  "required": ["meta", "projects", "stories", "tasks"],
  "additionalProperties": false,

  "definitions": {
    "status":   { "enum": ["new", "active", "hold", "done"] },
    "priority": { "enum": ["high", "medium", "low"] },
    "linkType": { "enum": ["blocks", "related", "duplicate-of", "precedes"] },
    "date":     { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "color":    { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "tags":     { "type": "array", "items": { "type": "string", "minLength": 1 } },

    "note": {
      "type": "object",
      "required": ["date", "text"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },

    "link": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type":   { "$ref": "#/definitions/linkType" },
        "target": { "type": "string", "pattern": "^S-\\d+$" }
      }
    }
  },

  "properties": {
    "meta": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version":     { "type": "integer", "minimum": 1 },
        "updated":     { "type": "string" },
        "idPrefixes":  { "type": "object" }
      }
    },

    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "color"],
        "additionalProperties": false,
        "properties": {
          "id":          { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
          "label":       { "type": "string", "minLength": 1 },
          "color":       { "$ref": "#/definitions/color" },
          "description": { "type": ["string", "null"] }
        }
      }
    },

    "tags": {
      "description": "Tag registry keyed by label. Stories and tasks reference tags by label string. A label used on an item but absent here still renders (in neutral grey) — the registry only adds color and description.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "color"],
        "additionalProperties": false,
        "properties": {
          "label":       { "type": "string", "minLength": 1 },
          "color":       { "$ref": "#/definitions/color" },
          "description": { "type": ["string", "null"] }
        }
      }
    },

    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "project", "priority"],
        "additionalProperties": false,
        "properties": {
          "id":          { "type": "string", "pattern": "^S-\\d+$" },
          "title":       { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "status":      { "$ref": "#/definitions/status" },
          "project":     { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
          "priority":    { "$ref": "#/definitions/priority" },
          "due":         { "$ref": "#/definitions/date" },
          "estimate":    { "type": ["integer", "null"], "minimum": 0 },
          "tags":        { "$ref": "#/definitions/tags" },
          "links":       { "type": "array", "items": { "$ref": "#/definitions/link" } },
          "notes":       { "type": "array", "items": { "$ref": "#/definitions/note" } },
          "created":     { "$ref": "#/definitions/date" },
          "completedAt": { "$ref": "#/definitions/date" }
        }
      }
    },

    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "storyId", "title", "status", "priority"],
        "additionalProperties": false,
        "properties": {
          "id":          { "type": "string", "pattern": "^T-\\d+$" },
          "storyId":     { "type": "string", "pattern": "^S-\\d+$" },
          "title":       { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "status":      { "$ref": "#/definitions/status" },
          "priority":    { "$ref": "#/definitions/priority" },
          "due":         { "$ref": "#/definitions/date" },
          "estimate":    { "type": ["integer", "null"], "minimum": 0 },
          "tags":        { "$ref": "#/definitions/tags" },
          "notes":       { "type": "array", "items": { "$ref": "#/definitions/note" } },
          "created":     { "$ref": "#/definitions/date" },
          "completedAt": { "$ref": "#/definitions/date" }
        }
      }
    }
  }
}
